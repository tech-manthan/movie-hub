# Copy to .env (git-ignored). Never commit real keys.
# TMDB: use either the v3 API key or the v4 read token.
TMDB_API_KEY=
TMDB_READ_TOKEN=

# VoiceStudio (only if you set an API key in its settings)
OMNIVOICE_API_KEY=
# OpenShorts needs Gemini for layout picking and silent footage
GEMINI_API_KEY=
# Google OAuth client for YouTube uploads (Desktop app type)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Instagram (Facebook Login): long-lived user token, only used once by `cinekahani instagram setup`
META_USER_TOKEN=
